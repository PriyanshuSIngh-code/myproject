# =====================================================================
# NayayaMitra Environment Configuration Template (.env.example)
# Copy this file to .env.local for local overrides. Never commit .env.local!
# =====================================================================

# -------------------------------------------------------------
# 1. Public Frontend Configuration
# -------------------------------------------------------------
VITE_APP_NAME=NayayaMitra
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# -------------------------------------------------------------
# 2. Backend Server & Security Configuration
# -------------------------------------------------------------
PORT=3001
NODE_ENV=development
JWT_SECRET=nayayamitra_production_jwt_secret_change_in_production_min_32_chars

# -------------------------------------------------------------
# 3. Real Email OTP Verification Service (Nodemailer / SMTP)
# When configured with valid SMTP credentials, real 6-digit OTP verification
# codes are delivered directly to user email inboxes.
# If omitted in development, the system operates in explicit Development
# Sandbox Mode and logs codes to the developer outbox.
# -------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_or_smtp_key
SMTP_FROM=NayayaMitra Security <no-reply@nayayamitra.in>

# -------------------------------------------------------------
# 4. Real Mobile SMS OTP Verification Service (Twilio / MSG91)
# When configured with valid Twilio credentials, real SMS verification
# codes are dispatched directly to registered international mobile numbers.
# If omitted in development, the system operates in explicit Development
# Sandbox Mode and logs codes to the developer outbox.
# -------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# -------------------------------------------------------------
# 5. AI Chatbot Intelligence Provider (Groq / OpenAI)
# -------------------------------------------------------------
# Option A (Recommended): Groq Ultra-Fast Inference (Llama 3.3 70B)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Option B: OpenAI (GPT-4o-mini)
# When configured, the chatbot leverages live GPT-4o-mini.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Note: If no cloud AI key is set, NayayaMitra automatically uses its
# built-in Deep Grounded Case Reasoner (nayaya-deep-case-engine-v3) offline.

# -------------------------------------------------------------
# 6. Payment Gateway Secrets (Optional)
# -------------------------------------------------------------
# RAZORPAY_KEY_ID=rzp_test_your_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_secret
